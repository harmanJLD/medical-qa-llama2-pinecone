# Pinecone (https://app.pinecone.io > API Keys)
PINECONE_API_KEY=
PINECONE_INDEX=medical-qa
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=default

# Hugging Face embedding model (384 dimensions)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Quantized Llama 2 7B chat model in GGUF format, e.g.
# https://huggingface.co/TheBloke/Llama-2-7B-Chat-GGUF  (llama-2-7b-chat.Q4_K_M.gguf)
LLAMA_MODEL_PATH=models/llama-2-7b-chat.Q4_K_M.gguf
LLAMA_N_CTX=4096
LLAMA_MAX_TOKENS=512
LLAMA_TEMPERATURE=0.2
LLAMA_GPU_LAYERS=0

# Ingestion and retrieval
DATA_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4

# Reranking: fetch FETCH_K chunks from Pinecone, rerank with a cross-encoder, keep TOP_K
FETCH_K=10
USE_RERANKER=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Answer only if the best chunk's relevance (0-1) reaches this; otherwise say "I don't know"
MIN_RELEVANCE=0.05
# Threshold used instead when USE_RERANKER=false (Pinecone cosine similarity)
MIN_VECTOR_SCORE=0.30

# Web server port (macOS uses 5000 for AirPlay Receiver)
PORT=5050
